# ── SentinelNexus.ai Backend Environment ─────────────────────────────────────
APP_NAME=SentinelNexus Guard
APP_VERSION=1.0.0
ENV=development
DEBUG=true

# ── Database ──────────────────────────────────────────────────────────────────
# Production: Supabase PostgreSQL (direct connection, supports Alembic DDL)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
# Local dev fallback:
# DATABASE_URL=sqlite:///./sentinel_nexus.db

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Security ──────────────────────────────────────────────────────────────────
# Generate a 64-byte random base64 string:
#   openssl rand -base64 64
SECRET_KEY={{SECRET_KEY}}
JWT_SECRET_KEY={{JWT_SECRET_KEY}}
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS / Hosts ──────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Clerk Authentication ──────────────────────────────────────────────────────
# Find these in Clerk Dashboard → API Keys
# Production: CLERK_JWKS_URL and CLERK_ISSUER are required for JWT verification.
CLERK_SECRET_KEY=sk_test_...
CLERK_JWKS_URL=https://{{YOUR_CLERK_DOMAIN}}/.well-known/jwks.json
CLERK_ISSUER=https://{{YOUR_CLERK_DOMAIN}}

# ── Frontend / Backend URLs ──────────────────────────────────────────────────
FRONTEND_BASE_URL=http://localhost:3000
BACKEND_BASE_URL=http://localhost:8000

# AI Configuration
GROQ_API_KEY=your_groq_api_key_here

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ── PayU Configuration ────────────────────────────────────────────────────────
PAYU_MERCHANT_KEY={{PAYU_MERCHANT_KEY}}
PAYU_MERCHANT_SALT={{PAYU_MERCHANT_SALT}}
PAYU_CLIENT_ID={{PAYU_CLIENT_ID}}
PAYU_CLIENT_SECRET={{PAYU_CLIENT_SECRET}}
PAYU_BASE_URL=https://test.payu.in/_payment
