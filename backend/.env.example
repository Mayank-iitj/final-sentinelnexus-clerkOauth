# ── SentinelNexus.ai Backend Environment ─────────────────────────────────────
APP_NAME=SentinelNexus Guard
APP_VERSION=1.0.0
ENV=development
DEBUG=true

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL for production, SQLite for local dev
DATABASE_URL=postgresql://sentinel:sentinel@localhost:5432/sentinel_nexus
# DATABASE_URL=sqlite:///./sentinel_nexus.db

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Security ──────────────────────────────────────────────────────────────────
# Generate a 64-byte random base64 string:
#   openssl rand -base64 64
SECRET_KEY={{SECRET_KEY}}
JWT_SECRET_KEY={{JWT_SECRET_KEY}}
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS / Hosts ──────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Clerk Authentication ──────────────────────────────────────────────────────
# Find these in Clerk Dashboard → API Keys
# Production: CLERK_JWKS_URL and CLERK_ISSUER are required for JWT verification.
CLERK_SECRET_KEY=sk_test_...
CLERK_JWKS_URL=https://{{YOUR_CLERK_DOMAIN}}/.well-known/jwks.json
CLERK_ISSUER=https://{{YOUR_CLERK_DOMAIN}}

# ── Frontend / Backend URLs ──────────────────────────────────────────────────
FRONTEND_BASE_URL=http://localhost:3000
BACKEND_BASE_URL=http://localhost:8000

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
