# ── Vercel Environment Variables ──────────────────────────────────────────────
#
# Set these in Vercel Dashboard → Settings → Environment Variables
#
# Required:
NEXTAUTH_URL=https://sentinelnexus.mayyanks.app
NEXTAUTH_SECRET=<generate with: openssl rand -base64 32>
NEXT_PUBLIC_API_URL=https://sentinelnexus-api-YOUR_HASH.run.app/api/v1
BACKEND_URL=https://sentinelnexus-api-YOUR_HASH.run.app

# Note: NEXT_PUBLIC_ vars are embedded at build time.
# After changing them you must redeploy.
