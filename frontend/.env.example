# ── SentinelNexus Frontend Environment ─────────────────────────────────────────
#
# Required — Clerk Authentication:
# Get these from https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Required — Clerk Redirect URLs:
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Required — API Communication:
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
BACKEND_URL=http://localhost:8000

# Required — OpenRouter (AI agents / copilot chat):
# The /api/v1/ai-agents/chat route handler calls OpenRouter server-side, so this must
# be set on the FRONTEND deployment too, not just the backend.
OPENROUTER_API_KEY=sk-or-v1-...
# Optional — override the chat model (default: nvidia/nemotron-3-ultra-550b-a55b:free)
# OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Optional — Site URL (for metadata, SEO):
# NEXT_PUBLIC_SITE_URL=https://sentinelnexus.mayankiitj.in
